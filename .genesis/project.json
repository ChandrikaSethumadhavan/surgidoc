  "decisions": [
    {
      "id": "DECISION-91208eb9",
      "title": "Gemini-only LLMs via Google AI Studio",
      "text": "All agent LLM calls (generator, judge) use Gemini free-tier models via Google AI Studio API. No OpenRouter/GPT/Claude. Embedding: Voyage multimodal + Cohere rerank only if free tier verified at implementation time, else gemini-embedding-001.",
      "status": "accepted",
      "source": "user 2026-10-26",
      "recorded_at": "2026-10-26T19:03:01.203Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-6fd5ba2e",
      "title": "Data: public only, human approval mandatory",
      "text": "Only public datasets (Kaggle newslab/cholecseg8k via kagglehub, plus public EU/Germany-focused endoscopy surgery text) are used. No real patient data. Every generated report requires human approval; output is a draft, never a diagnosis.",
      "status": "accepted",
      "source": "user 2026-10-26",
      "recorded_at": "2026-10-26T19:03:01.492Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-0737e188",
      "title": "Scope: all layers, production/enterprise grade, Python",
      "text": "Build every layer in Architecture Flowchart.png (RAG, LangGraph generator/judge, guardrails, gateway, human approval, PDF, TigerCloud+Redis, observability, security/governance). Python, LangGraph, pytest, tests for every component. Secrets in git-ignored keys.txt. DECISIONS.md consulted before every decision.",
      "status": "accepted",
      "source": "user 2026-10-26",
      "recorded_at": "2026-10-26T19:03:01.701Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-321ba356",
      "title": "EndoViT runs remotely, not on local CPU",
      "text": "User CPU is weak. EndoViT inference must go through a free hosted option (to be found; none confirmed). Frame-description sits behind an interface so a Gemini-vision fallback is possible.",
      "status": "accepted",
      "source": "user 2026-10-26",
      "recorded_at": "2026-10-26T19:03:01.881Z",
      "paths": [],
      "tags": []
    }
